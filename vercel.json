{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/u/:handle",
      "destination": "/u/index.html"
    },
    {
      "source": "/p/:handle/:date",
      "destination": "/p/index.html"
    },
    {
      "source": "/book/:handle/:bookId",
      "destination": "/book/index.html"
    }
  ]
}
