---
// 나눈 하루 전부 — /pages/
// 메인 신문의 Pages 구역에서 '전부 보기'로 들어오는 자리. 월별로 묶어 놓는다.
import Base from '../../layouts/Base.astro';
import '../../styles/press.css';
---

<Base title="나눈 하루 — PULLSTORY" description="사람들이 나눈 하루가 모인 자리.">
  <div id="list" class="press">
    <div class="bar"><a href="/">‹ PULLSTORY</a><span>나눈 하루</span></div>
    <div class="head">
      <div class="om">Pages</div>
      <h1>나눈 하루</h1>
      <p>다 채운 하루가 한 장씩 놓입니다.</p>
    </div>
    <p class="empty">지면을 펴는 중…</p>
  </div>

  <style is:global>
    #list .days { display: grid; grid-template-columns: repeat(auto-fill, minmax(158px, 1fr)); gap: 12px; }
    #list .day {
      border: 1px solid rgba(120,90,40,.24); background: #fffdf6; text-decoration: none;
      display: block; box-shadow: 0 2px 7px rgba(60,40,15,.12);
    }
    #list .day .im { display: block; height: 92px; background: rgba(120,90,40,.1);
      background-size: cover; background-position: center; }
    #list .day .bd { display: block; padding: 9px 10px 11px; }
    #list .day .dt { display: block; font-family: Georgia, serif; font-size: 10px; color: #a08a5e;
      font-variant-numeric: tabular-nums; }
    #list .day .cp { display: -webkit-box; font-size: 11.5px; color: var(--body); margin-top: 4px;
      line-height: 1.55; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    #list .day .ep { display: block; margin-top: 6px; }
  </style>

  <script is:inline src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>
  <script is:inline>
    (function () {
      var root = document.getElementById('list');
      var db = firebase.firestore();
      var MON = ['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE',
                 'JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }

      function card(c) {
        var d = String(c.date || '');
        return '<a class="day" href="/p/' + esc(c.handle) + '/' + esc(d) + '" data-photo="' + esc(c.keyPhotoId || '') + '">' +
          '<span class="im"></span><span class="bd">' +
            '<span class="dt">' + parseInt(d.slice(5,7),10) + '. ' + parseInt(d.slice(8,10),10) + '</span>' +
            '<span class="cp">' + esc(c.caption || '이 하루의 기록') + '</span>' +
            '<span class="ep who">by <b>' + esc(c.penName || c.handle) + '</b></span>' +
          '</span></a>';
      }

      function loadPhotos() {
        Array.prototype.forEach.call(root.querySelectorAll('.day[data-photo]'), function (el) {
          var id = el.getAttribute('data-photo');
          if (!id) return;
          db.collection('photos').doc(id).get().then(function (s) {
            if (!s.exists) return;
            var d = s.data().data;
            if (d) el.querySelector('.im').style.backgroundImage = 'url("' + d + '")';
          }).catch(function () {});
        });
      }

      db.collection('feed').orderBy('publishedAt', 'desc').limit(300).get()
        .then(function (snap) {
          var rows = [];
          snap.forEach(function (d) {
            var x = d.data();
            if (x.kind === 'page' && x.pageDone !== false) rows.push(x);
          });
          rows.sort(function (a, b) { return a.date < b.date ? 1 : -1; });

          var tail = root.querySelector('.empty');
          if (!rows.length) {
            tail.textContent = '아직 나눈 하루가 없습니다.';
            return;
          }

          var byMon = {};
          rows.forEach(function (c) {
            var k = String(c.date || '').slice(0, 7);
            (byMon[k] = byMon[k] || []).push(c);
          });

          var html = '';
          Object.keys(byMon).sort().reverse().forEach(function (k) {
            var y = k.slice(0, 4), m = parseInt(k.slice(5, 7), 10);
            html += '<div class="mon">' + y + ' · ' + (MON[m - 1] || '') + '</div>' +
              '<div class="days">' + byMon[k].map(card).join('') + '</div>';
          });
          html += '<div class="foot">' + rows.length + '장이 놓여 있습니다<br/>' +
            '<a href="/">신문으로 돌아가기 →</a></div>';

          tail.outerHTML = html;
          loadPhotos();
        })
        .catch(function (e) {
          root.querySelector('.empty').textContent = '지면을 열지 못했습니다: ' + e.message;
        });
    })();
  </script>
</Base>
