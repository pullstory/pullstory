---
// My shelf = 내 책장으로 가는 문. 진짜 책장은 /u/{handle}에 있다.
// 로그인해 있으면 곧장 자기 책장으로 보내고, 아직 주소가 없으면 작업실로 안내한다.
import Base from '../layouts/Base.astro';
---
<Base title="My shelf · PULLSTORY" description="PULLSTORY 책장 — 내가 나눈 하루와 책이 놓인 자리.">
  <div id="door">
    <p class="lede">책장을 찾는 중…</p>
  </div>

  <!-- 로그인 안 한 사람 -->
  <template id="t-guest">
    <p class="lede">책장은 내가 나눈 하루와 책이 놓이는 자리입니다.<br />로그인하면 내 책장으로 갑니다.</p>
    <button class="app-open" type="button" id="go-login">로그인하고 내 책장 열기</button>
  </template>

  <!-- 로그인했지만 아직 책장 주소가 없는 사람 -->
  <template id="t-nohandle">
    <p class="lede">아직 책장 주소를 정하지 않았어요.<br />작업실 Desk에서 주소를 정하면 이 자리에 책장이 생깁니다.</p>
    <section class="app-entry">
      <h2>CASH Room</h2>
      <p class="app-desc">내 이야기를 짓는 작업실 방. 매일의 기록으로 나만의 책을 만들어, 이 책장에 진열합니다.</p>
      <a class="app-open" href="/app/">CASH Room 들어가기 →</a>
    </section>
  </template>

  <script is:inline src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>
  <script is:inline>
    (function () {
      var door = document.getElementById('door');
      var auth = firebase.auth();
      var db = firebase.firestore();

      function show(id) {
        var t = document.getElementById(id);
        door.innerHTML = '';
        door.appendChild(t.content.cloneNode(true));
        var b = document.getElementById('go-login');
        if (b) b.addEventListener('click', function () {
          auth.signInWithPopup(new firebase.auth.GoogleAuthProvider())
            .catch(function (e) { alert('로그인 실패: ' + e.message); });
        });
      }

      auth.onAuthStateChanged(function (u) {
        if (!u) { show('t-guest'); return; }
        door.innerHTML = '<p class="lede">책장을 여는 중…</p>';
        db.collection('users').doc(u.uid).get()
          .then(function (s) {
            var h = s.exists && s.data().handle;
            if (h) location.replace('/u/' + encodeURIComponent(h));
            else show('t-nohandle');
          })
          .catch(function () { show('t-nohandle'); });
      });
    })();
  </script>
</Base>
