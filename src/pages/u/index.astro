---
// 남의 책장 — /u/{handle}
// 정적 사이트라 주소의 handle은 브라우저에서 읽는다 (vercel.json 재작성 규칙이 여기로 보낸다).
import Base from '../../layouts/Base.astro';
---

<Base title="책장 — PULLSTORY" description="누군가 나눈 하루와 책이 놓인 책장.">
  <div id="shelf-root">
    <p class="loading">책장을 펴는 중…</p>
  </div>

  <style is:global>
    /* 읽는 화면만은 앱과 같은 세계로 — 서점에 책을 보러 온 것이지 웹페이지를 보러 온 게 아니다 */
    #shelf-root {
      position: relative;
      overflow: hidden;
      --ink: #3a2818; --deep: #2f2109; --muted: #8a6d3c; --faint: #a89066;
      --gold: #9c7420; --line: rgba(120,90,40,.22);
      font-family: 'Noto Serif KR', Georgia, serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 20% 30%, rgba(237,226,197,.4), transparent 60%),
        linear-gradient(#f5ecd9, #f1e6cf);
      border-radius: 10px;
      padding: 22px 16px 26px;
      margin: 1rem 0 2rem;
    }
    #shelf-root .loading,
    #shelf-root .empty { text-align: center; color: var(--faint); font-style: italic; padding: 34px 12px; line-height: 1.8; }

    /* 모서리 접기 — 이 책장을 내 서재에 들인다.
       안 걸렸을 땐 색이 없다. 색이 곧 상태다. */
    #shelf-root .mark {
      position: absolute; top: 0; right: 0; width: 44px; height: 44px;
      padding: 0; border: none; background: none; cursor: pointer; z-index: 3;
      transition: width .22s cubic-bezier(.3,.8,.4,1), height .22s cubic-bezier(.3,.8,.4,1);
    }
    #shelf-root .mark[hidden] { display: none; }
    #shelf-root .mark .fold {
      position: absolute; inset: 0;
      clip-path: polygon(100% 0, 100% 100%, 0 0);
      background: rgba(120,90,40,.13);
      box-shadow: inset -1px 1px 0 rgba(120,90,40,.32);
      filter: drop-shadow(-2px 2px 2px rgba(60,40,15,.28));
      transition: background .22s;
    }
    #shelf-root .mark .mk {
      position: absolute; top: 7px; right: 8px; font-style: normal;
      font-family: Georgia, serif; font-size: 12px; font-weight: 700;
      color: #9a8760; line-height: 1; transition: color .22s, top .22s, right .22s;
    }
    #shelf-root .mark[aria-pressed="true"] { width: 52px; height: 52px; }
    #shelf-root .mark[aria-pressed="true"] .fold {
      background: linear-gradient(225deg, #c9534c 0%, #b23f39 55%, #8f2f2a 100%);
      box-shadow: inset -1px 1px 0 rgba(255,240,238,.32);
    }
    #shelf-root .mark[aria-pressed="true"] .mk { color: #fff3f1; top: 8px; right: 9px; }
    #shelf-root .say { padding-right: 26px; }

    /* 지은이 — 왼쪽에 사람, 오른쪽에 그가 스스로 붙인 말 */
    #shelf-root .who { padding-bottom: 16px; border-bottom: 1px solid var(--line); }
    #shelf-root .top { display: flex; gap: 14px; align-items: flex-start; }
    #shelf-root .top.alone { justify-content: center; }
    #shelf-root .top.alone .me { flex: 0 0 auto; }
    #shelf-root .top.alone .pen { font-size: 18px; }
    #shelf-root .top.alone .handle { font-size: 10.5px; }
    #shelf-root .me { flex: 0 0 84px; min-width: 0; text-align: center; }
    #shelf-root .say { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
    #shelf-root .av {
      width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 8px; overflow: hidden;
      background: radial-gradient(circle at 35% 30%, #e7c98a, #9c7420); color: #3a2610;
      display: flex; align-items: center; justify-content: center;
      font-family: Georgia, serif; font-weight: 700; font-size: 23px;
      background-size: cover; background-position: center;
    }
    #shelf-root .pen { font-size: 14.5px; font-weight: 700; color: var(--deep); line-height: 1.4; }
    #shelf-root .handle { font-family: ui-monospace, Menlo, monospace; font-size: 9px; color: #a8894e;
      margin-top: 3px; word-break: break-all; }
    /* identity — 지은이가 스스로 정한 한 줄 */
    #shelf-root .idt {
      border: 1px solid rgba(156,116,32,.42); border-radius: 4px; background: rgba(255,255,255,.6);
      padding: 10px 12px; font-size: 12.5px; font-weight: 700; color: var(--deep);
      line-height: 1.65; white-space: pre-wrap;
    }
    #shelf-root .bio {
      border: 1px solid rgba(120,90,40,.22); border-radius: 4px; background: rgba(255,255,255,.32);
      padding: 10px 12px; font-size: 11.5px; color: var(--muted); line-height: 1.85; white-space: pre-wrap;
    }

    #shelf-root .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 13px; }
    #shelf-root .stat { position: relative; border: 1px solid rgba(156,116,32,.4); border-radius: 3px;
      padding: 10px 3px 9px; text-align: center; background: rgba(255,255,255,.45); }
    #shelf-root .stat::before { content:""; position:absolute; inset:3px; border:1px solid rgba(156,116,32,.18); border-radius:2px; }
    #shelf-root .stat b { position: relative; display: block; font-family: Georgia, serif; font-size: 22px;
      font-weight: 700; line-height: 1; color: var(--gold); }
    #shelf-root .stat span { position: relative; display: block; font-family: Georgia, serif; font-size: 9px;
      letter-spacing: .16em; color: var(--muted); margin-top: 5px; font-weight: 700; }

    /* 구역 */
    #shelf-root .sect { display: flex; align-items: baseline; gap: 8px; margin: 24px 0 12px; }
    #shelf-root .sect b { font-family: Georgia, serif; font-size: 11.5px; letter-spacing: .2em; color: var(--gold);
      text-transform: uppercase; font-weight: 700; white-space: nowrap; }
    #shelf-root .sect i { font-style: normal; font-size: 10px; color: var(--faint); }
    #shelf-root .sect u { flex: 1; height: 1px; background: var(--line); text-decoration: none; }
    /* 구역 끝의 손잡이 — 좌우로 밀거나, 전부 펼쳐 보거나 */
    #shelf-root .sect .nav { display: flex; align-items: center; gap: 4px; flex-shrink: 0; align-self: center; }
    #shelf-root .sect .nav button {
      width: 21px; height: 21px; border-radius: 50%; border: 1px solid #d6bc85; background: rgba(255,255,255,.5);
      color: #a8894e; cursor: pointer; font-size: 9px; line-height: 1; padding: 0;
    }
    #shelf-root .sect .nav button:disabled { opacity: .3; cursor: default; }
    #shelf-root .sect .more {
      font-size: 10px; color: var(--gold); text-decoration: none; font-weight: 700;
      white-space: nowrap; margin-left: 3px;
    }
    #shelf-root .sect .more:hover { text-decoration: underline; }

    /* 좌우로 미는 한 줄 — 스크롤바는 감춘다 */
    #shelf-root .rail {
      display: flex; gap: 10px; overflow-x: auto; scroll-behavior: smooth;
      scroll-snap-type: x proximity; scrollbar-width: none; -ms-overflow-style: none;
    }
    #shelf-root .rail::-webkit-scrollbar { display: none; }
    #shelf-root .rail > * { scroll-snap-align: start; flex: 0 0 auto; }

    /* 책장 */
    #shelf-root .case { padding: 13px 11px 0; border-radius: 5px;
      background: linear-gradient(160deg, #5a3d22, #33220f 75%);
      box-shadow: inset 0 0 0 1px rgba(200,160,90,.2); }
    #shelf-root .books > .bk { width: 92px; }
    #shelf-root .plank { height: 9px; margin: 12px -11px 0;
      background: linear-gradient(180deg, #9a6528, #6a441f); box-shadow: 0 4px 7px rgba(0,0,0,.45); }
    #shelf-root .bk { position: relative; aspect-ratio: 3/4.2; border-radius: 3px 6px 6px 3px; overflow: hidden;
      display: flex; box-shadow: 0 6px 13px rgba(0,0,0,.4); text-decoration: none; min-width: 0; }
    #shelf-root .bk .sp { width: 6px; flex-shrink: 0; }
    #shelf-root .bk .in { flex: 1; position: relative; padding: 8px 7px; display: flex; flex-direction: column; min-width: 0; }
    #shelf-root .bk .fr { position: absolute; inset: 5px; border: 1px solid rgba(255,248,220,.35); border-radius: 2px; }
    #shelf-root .bk .ty { display: block; position: relative; font-size: 7px; font-weight: 700; color: rgba(255,248,220,.85); }
    #shelf-root .bk .tt { position: relative; font-size: 10.5px; font-weight: 700; color: #fff8e5; line-height: 1.3;
      margin-top: auto; text-shadow: 0 1px 4px rgba(0,0,0,.5);
      overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
    #shelf-root .bk .st { display: block; position: relative; font-family: Georgia, serif; font-size: 8px;
      font-style: italic; color: rgba(255,248,220,.82); margin-top: 3px; }
    #shelf-root .bk.story .in { background: linear-gradient(150deg, #3f2e1c, #241812); }
    #shelf-root .bk.story .fr { border-color: rgba(226,190,110,.55); }
    #shelf-root .bk.story .tt { font-family: Georgia, serif; font-size: 12px; }

    /* 하루 */
    #shelf-root .days > .day { width: 152px; }
    #shelf-root .day { border-radius: 5px; overflow: hidden; background: #fffdf6; text-decoration: none;
      box-shadow: 0 3px 10px rgba(60,40,15,.16); border: 1px solid rgba(120,90,40,.14); display: block; }
    #shelf-root .day .im { display: block; height: 84px; background: rgba(120,90,40,.1);
      background-size: cover; background-position: center; }
    #shelf-root .day .bd { display: block; padding: 8px 9px 10px; }
    #shelf-root .day .dt { display: block; font-family: Georgia, serif; font-size: 10px; color: #a08a5e; }
    #shelf-root .day .cp { font-size: 10.5px; color: var(--ink); margin-top: 4px; line-height: 1.55;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    #shelf-root .day .ep { display: block; font-family: Georgia, serif; font-size: 9px; color: #b09a6e;
      margin-top: 5px; font-style: italic; }

    /* 글 — 제목과 날짜만. 본문은 열어야 나온다 */
    #shelf-root .sheet { display: flex; align-items: center; gap: 11px;
      background: #fffdf6; border: 1px solid rgba(120,90,40,.18); border-radius: 2px;
      padding: 12px 13px; margin-bottom: 8px; box-shadow: 0 2px 5px rgba(60,40,15,.11);
      text-decoration: none; }
    #shelf-root .sheet .m { flex: 1; min-width: 0; }
    #shelf-root .sheet .t { display: block; font-size: 13px; font-weight: 700; color: var(--deep); line-height: 1.5; }
    #shelf-root .sheet .d { display: block; font-family: Georgia, serif; font-size: 10px; color: #a8894e;
      margin-top: 3px; font-variant-numeric: tabular-nums; }
    #shelf-root .sheet .d b { font-weight: 400; color: var(--gold); font-family: 'Noto Serif KR', serif; }
    #shelf-root .sheet .go { flex-shrink: 0; color: #c7ae7a; font-size: 14px; }
    #shelf-root .sheet:hover .go { color: var(--gold); }

    #shelf-root .foot { text-align: center; font-size: 10px; color: var(--faint); font-style: italic;
      margin-top: 22px; padding-top: 14px; border-top: 1px solid var(--line); line-height: 1.8; }

    /* 주인에게만 — 책장 뒤편의 작업실 문 */
    #shelf-root .mine[hidden] { display: none; }
    #shelf-root .mine { display: flex; align-items: center; gap: 9px; margin-top: 15px;
      padding: 10px 12px; border: 1px solid rgba(156,116,32,.32); border-radius: 5px;
      background: rgba(255,255,255,.4); }
    #shelf-root .mine .m { flex: 1; font-size: 10.5px; color: var(--muted); line-height: 1.6; }
    #shelf-root .mine .m b { display: block; font-family: Georgia, serif; font-size: 11px;
      letter-spacing: .14em; color: var(--gold); }
    #shelf-root .mine a { flex-shrink: 0; text-decoration: none; font-size: 11px; font-weight: 700;
      color: #fff8ea; background: linear-gradient(135deg, #c8a05a, #96702a);
      padding: 8px 12px; border-radius: 5px; }
  </style>

  <script is:inline src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>
  <script is:inline>
    (function () {
      var root = document.getElementById('shelf-root');
      var db = firebase.firestore();
      var ownerUid = null, meUid = null;
      var marked = false, markBusy = false;

      // 이 책장의 주인이 보고 있을 때만 작업실 문이 보인다
      function markOwner() {
        var el = root.querySelector('.mine');
        if (el) el.hidden = !(meUid && ownerUid && meUid === ownerUid);
      }

      // 모서리 접기 — 자기 책장에는 접을 것이 없다
      function paintMark() {
        var el = root.querySelector('.mark');
        if (!el) return;
        el.hidden = !!(meUid && ownerUid && meUid === ownerUid);
        el.setAttribute('aria-pressed', marked ? 'true' : 'false');
        el.querySelector('.mk').textContent = marked ? '✓' : '＋';
        el.title = marked ? '내 서재에 있음' : '내 서재에 들이기';
      }

      // 없는 문서를 직접 집어 오는 대신 조회로 확인한다 —
      // 규칙이 resource.data.uid 하나만 보면 되고, 없으면 빈 결과가 돌아온다
      function loadMark() {
        if (!meUid || (ownerUid && meUid === ownerUid)) { marked = false; paintMark(); return; }
        db.collection('shelfmarks')
          .where('uid', '==', meUid).where('handle', '==', handle).limit(1).get()
          .then(function (s) { marked = !s.empty; paintMark(); })
          .catch(function (e) { console.warn('shelfmark:', e); paintMark(); });
      }

      function toggleMark() {
        if (markBusy) return;
        if (!meUid) {
          firebase.auth().signInWithPopup(new firebase.auth.GoogleAuthProvider())
            .catch(function (e) { alert('로그인이 안 됐어요: ' + e.message); });
          return;
        }
        markBusy = true;
        var next = !marked;
        marked = next;
        paintMark();                       // 먼저 접히고, 저장은 뒤따른다
        var ref = db.collection('shelfmarks').doc(meUid + '_' + handle);
        (next
          ? ref.set({uid: meUid, handle: handle, targetUid: ownerUid || null, createdAt: Date.now()})
          : ref.delete()
        ).then(function () { markBusy = false; })
         .catch(function (e) {
           marked = !next; paintMark(); markBusy = false;
           console.warn('shelfmark save:', e);
           alert('잘 안 됐어요. 잠시 뒤 다시 해주세요.');
         });
      }

      firebase.auth().onAuthStateChanged(function (u) {
        meUid = u ? u.uid : null;
        markOwner();
        loadMark();
      });

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      // /u/hyunwook → hyunwook  (?u= 로도 받는다 — 재작성 규칙이 없는 환경에서 확인용)
      var parts = location.pathname.split('/').filter(Boolean);
      var qs = new URLSearchParams(location.search);
      var handle = decodeURIComponent(qs.get('u') || parts[1] || '').toLowerCase();

      if (!handle) {
        root.innerHTML = '<p class="empty">책장 주소가 없습니다.<br/>pullstory.net/u/이름 형태로 들어와 주세요.</p>';
        return;
      }

      var CAT = {
        C: { sp: '#c98f22', g: 'linear-gradient(140deg,#e3ad35,#c8901f)' },
        A: { sp: '#9c332e', g: 'linear-gradient(140deg,#c04a44,#a3352f)' },
        S: { sp: '#315b86', g: 'linear-gradient(140deg,#487eb2,#325f8c)' },
        H: { sp: '#3a6e3e', g: 'linear-gradient(140deg,#4f9354,#37703c)' }
      };
      var RAIL = 5;   // 한 줄에 내놓는 최신 개수

      // 2026-08-01 → 8. 1
      function shortDate(d) {
        var p = String(d || '').split('-');
        if (p.length < 3) return d || '';
        return parseInt(p[1], 10) + '. ' + parseInt(p[2], 10);
      }

      function typeIcon(t) { return t === 'habit' ? '🔁 습관' : t === 'collection' ? '✍️ 묶음' : '🏆 성취'; }

      function bookCard(c) {
        var cat = CAT[c.cat] || CAT.C;
        var st = c.type === 'collection' ? ('글 ' + (c.postCount || 0) + '편')
               : c.type === 'habit' ? ((c.filled || 0) + '/' + (c.total || 0))
               : ('글 ' + (c.postCount || 0) + '편');
        return '<a class="bk" href="/book/' + esc(handle) + '/' + esc(c.bookId) + '">' +
          '<span class="sp" style="background:' + cat.sp + '"></span>' +
          '<span class="in" style="background:' + cat.g + '">' +
            '<span class="fr"></span>' +
            '<span class="ty">' + typeIcon(c.type) + '</span>' +
            '<span class="tt">' + esc(c.title || '(제목 없음)') + '</span>' +
            '<span class="st">' + esc(st) + '</span>' +
          '</span></a>';
      }

      function storyCard(n) {
        return '<a class="bk story" href="/story/' + esc(handle) + '">' +
          '<span class="sp" style="background:#8a6a2a"></span>' +
          '<span class="in"><span class="fr"></span>' +
            '<span class="ty">📖 스토리북</span>' +
            '<span class="tt">Story<br/>Book</span>' +
            '<span class="st">' + n + '장</span>' +
          '</span></a>';
      }

      function dayCard(c) {
        return '<a class="day" href="/p/' + esc(handle) + '/' + esc(c.date) + '" data-photo="' + esc(c.keyPhotoId || '') + '">' +
          '<span class="im"></span>' +
          '<span class="bd">' +
            '<span class="dt">' + esc(shortDate(c.date)) + '</span>' +
            (c.caption ? '<span class="cp">' + esc(c.caption) + '</span>' : '') +
            '<span class="ep">에피소드 ' + (c.count || 0) + '</span>' +
          '</span></a>';
      }

      function noteCard(c) {
        var when = new Date(c.publishedAt || Date.now());
        var d = when.getFullYear() + '. ' + (when.getMonth() + 1) + '. ' + when.getDate() + '.';
        return '<a class="sheet" href="/n/' + esc(handle) + '/' + esc(c.noteId) + '">' +
          '<span class="m">' +
            '<span class="t">' + esc(c.title || '(제목 없음)') + '</span>' +
            '<span class="d">' + d + (c.bookTitle ? ' · <b>' + esc(c.bookTitle) + '</b>' : '') + '</span>' +
          '</span>' +
          '<span class="go">→</span></a>';
      }

      function render(profile, cards) {
        var books = cards.filter(function (c) { return c.kind === 'book'; });
        // 다 채우지 못한 하루는 진열대에 오르지 않는다 — 스토리북 안에서만 읽힌다.
        // 다만 스토리북 표지의 장수는 그 못다 채운 날까지 센다. 그 책에는 다 들어 있으니까.
        var allPages = cards.filter(function (c) { return c.kind === 'page'; });
        var pages = allPages.filter(function (c) { return c.pageDone !== false; });
        var notes = cards.filter(function (c) { return c.kind === 'note'; });
        var pen = profile.penName || '이름 없는 지은이';
        var st = profile.stats || {};

        // 스스로 붙인 말이 아직 없으면 지은이만 가운데 세운다
        var hasSay = !!(profile.identity || profile.intro);
        var html =
          '<button class="mark" type="button" aria-pressed="false" hidden>' +
            '<span class="fold"></span><i class="mk">＋</i>' +
          '</button>' +
          '<div class="who"><div class="top' + (hasSay ? '' : ' alone') + '">' +
            '<div class="me">' +
              '<div class="av" data-photo="' + esc(profile.avatarId || '') + '">' +
                (profile.avatarId ? '' : esc(pen.slice(0, 1))) + '</div>' +
              '<div class="pen">' + esc(pen) + '</div>' +
              '<div class="handle">@' + esc(handle) + '</div>' +
            '</div>' +
            '<div class="say">' +
              (profile.identity ? '<div class="idt">' + esc(profile.identity) + '</div>' : '') +
              (profile.intro ? '<div class="bio">' + esc(profile.intro) + '</div>' : '') +
            '</div>' +
          '</div>';

        if (st.day || st.page || st.cash) {
          html += '<div class="stats">' +
            '<div class="stat"><b>' + (st.day || 0) + '</b><span>DAY</span></div>' +
            '<div class="stat"><b>' + (st.page || 0) + '</b><span>PAGE</span></div>' +
            '<div class="stat"><b>' + (st.cash || 0) + '</b><span>C.A.S.H</span></div>' +
          '</div>';
        }
        html += '</div>';

        html += '<div class="mine" hidden><div class="m"><b>MY SHELF</b>내 책장을 보고 있어요</div>' +
          '<a href="/app/">작업실 열기 →</a></div>';

        if (!cards.length) {
          html += '<p class="empty">아직 나눈 것이 없습니다.<br/>' + esc(pen) + '의 이야기는 아직 책 안에 있습니다.</p>';
          root.innerHTML = html;
          markOwner();
          wireMark();
          loadMark();
          loadPhotos();
          return;
        }

        // 한 줄에 최신 것만 내놓고, 나머지는 '전부 보기'가 맡는다
        function sect(id, name, sub, count, more) {
          return '<div class="sect" id="' + id + '"><b>' + name + '</b><i>' + sub + '</i><u></u>' +
            (count > RAIL ? '<span class="nav">' +
              '<button type="button" data-rail="' + id + '" data-dir="-1">◀</button>' +
              '<button type="button" data-rail="' + id + '" data-dir="1">▶</button>' +
              '<a class="more" href="' + more + '">전부 보기 →</a></span>' : '') +
          '</div>';
        }

        if (books.length || allPages.length) {
          var shown = books.slice(0, RAIL);
          html += sect('books', 'Books', '펴낸 책', books.length, '/books/' + encodeURIComponent(handle)) +
            '<div class="case"><div class="rail books" data-rail-body="books">' +
            (allPages.length ? storyCard(allPages.length) : '') +
            shown.map(bookCard).join('') +
            '</div><div class="plank"></div></div>';
        }

        if (pages.length) {
          html += sect('pages', 'Pages', '나눈 하루', pages.length, '/story/' + encodeURIComponent(handle)) +
            '<div class="rail days" data-rail-body="pages">' +
            pages.slice(0, RAIL).map(dayCard).join('') + '</div>';
        }

        // 글은 밀지 않고 쌓인다 — 최신이 위
        if (notes.length) {
          html += '<div class="sect"><b>Notes</b><i>쓴 글</i><u></u></div>' + notes.map(noteCard).join('');
        }

        html += '<div class="foot">' + esc(pen) + '이 나눈 것들입니다<br/>나머지는 아직 그의 책 안에 있습니다</div>';
        root.innerHTML = html;
        markOwner();
        wireMark();
        loadMark();
        wireRails();
        loadPhotos();
      }

      function wireMark() {
        var el = root.querySelector('.mark');
        if (el) el.addEventListener('click', toggleMark);
      }

      // ◀▶ 는 한 화면씩 민다
      function wireRails() {
        Array.prototype.forEach.call(root.querySelectorAll('.sect button[data-rail]'), function (b) {
          b.addEventListener('click', function () {
            var body = root.querySelector('[data-rail-body="' + b.getAttribute('data-rail') + '"]');
            if (!body) return;
            body.scrollBy({ left: body.clientWidth * 0.8 * parseInt(b.getAttribute('data-dir'), 10), behavior: 'smooth' });
          });
        });
      }

      // 대표 사진은 카드마다 한 장씩 따로 불러온다
      function loadPhotos() {
        var av = root.querySelector('.av[data-photo]');
        if (av && av.getAttribute('data-photo')) {
          db.collection('photos').doc(av.getAttribute('data-photo')).get().then(function (s) {
            if (!s.exists) return;
            var d = s.data().data;
            if (d) av.style.backgroundImage = 'url("' + d + '")';
          }).catch(function () {});
        }
        var els = root.querySelectorAll('.day[data-photo]');
        Array.prototype.forEach.call(els, function (el) {
          var id = el.getAttribute('data-photo');
          if (!id) return;
          db.collection('photos').doc(id).get().then(function (s) {
            if (!s.exists) return;
            var d = s.data().data;
            if (d) el.querySelector('.im').style.backgroundImage = 'url("' + d + '")';
          }).catch(function () {});
        });
      }

      db.collection('users').where('handle', '==', handle).limit(1).get()
        .then(function (snap) {
          if (snap.empty) {
            root.innerHTML = '<p class="empty">이 주소의 책장을 찾지 못했습니다.<br/>주소를 다시 확인해 주세요.</p>';
            return;
          }
          var profile = snap.docs[0].data();
          ownerUid = snap.docs[0].id;
          return db.collection('feed').where('handle', '==', handle).get()
            .then(function (fs) {
              var cards = [];
              fs.forEach(function (d) { var x = d.data(); x.id = d.id; cards.push(x); });
              cards.sort(function (a, b) { return (b.publishedAt || 0) - (a.publishedAt || 0); });
              render(profile, cards);
            });
        })
        .catch(function (e) {
          root.innerHTML = '<p class="empty">책장을 열지 못했습니다.<br/>' + esc(e.message) + '</p>';
        });
    })();
  </script>
</Base>
