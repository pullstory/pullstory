---
// About = 브랜드/공간 소개, 이용법, 공지 (Notion 'About' 페이지)
// 맨 위엔 방이 돌아가는 장면 — 스크롤이 곧 회전각이고, 장면마다 읽을 것이 붙는다.
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/notion.js';

const md = await getPage('about');
const html = md ? marked.parse(md) : '';

// ── 카피는 여기만 고치면 된다 ──────────────────────────
// win = 스크롤 진행도(0=시작, 1=끝) 위에서 [떠오르기 시작, 다 보임, 머무는 끝, 다 사라짐]
const COPY = [
  {
    win: [-1, -1, 0.24, 0.36],
    title: '혼자 쓰는 방',
    body: '누구의 삶에나 자기만의 방이 하나 있습니다.\n책상 하나, 등 하나, 그리고 아직 쓰이는 중인 이야기.',
  },
  {
    win: [0.42, 0.5, 0.6, 0.7],
    title: '쓰는 동안',
    body: '하루가 한 장이 되고, 쌓인 장이 한 권이 됩니다.',
  },
  {
    win: [0.76, 0.86, 2, 2],
    title: '누군가 읽는다',
    body: '다 쓴 책은 서가에 꽂힙니다.\n당신의 하루가 누군가의 읽을거리가 되는 자리.',
  },
];
---
<Base title="About · PULLSTORY" description="PULLSTORY — 이 공간이 어떤 곳인지, 어떻게 이용하는지 안내합니다.">
  <!-- 문 앞 — 아직 들어가기 전 -->
  <section class="street">
    <img src="/img/pullstory-street.webp" alt="PULLSTORY 가게 앞에 선 사람" />
  </section>

  <!-- 돌아가는 방 — 스크롤한 만큼 돌고, 도는 동안 읽는다 -->
  <section class="turn" id="turn" aria-label="스토리 룸">
    <div class="turn-stage">
      <div class="turn-obj">
        <img class="f a" src="/img/story-room-writing.webp" alt="책 속에 지어진 방에서 글을 쓰는 사람" />
        <img class="f b" src="/img/story-room-open.webp" alt="책을 펼쳐 서가에 꽂는 사람" aria-hidden="true" />
      </div>

      <div class="turn-copy">
        {COPY.map((c) => (
          <div class="cp" data-win={c.win.join(',')}>
            <b>{c.title}</b>
            <p>{c.body}</p>
          </div>
        ))}
      </div>

      <span class="turn-hint" aria-hidden="true"></span>
    </div>
  </section>

  {html
    ? <article set:html={html} />
    : <article><h1>About</h1><p>준비 중입니다.</p></article>}

  <style is:global>
    /* 문 앞 한 장 — 회전이 시작되기 전에 */
    .street { margin: 0 0 2vh; }
    .street img { display: block; width: 100%; margin: 0; border-radius: 0; }

    /* 스크롤 길이가 곧 회전 각도 — 이 구간을 지나는 동안 180° 돈다 */
    .turn { height: 300vh; margin: -1rem 0 2rem; }
    .turn-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      perspective: 1500px;
      perspective-origin: 50% 42%;
    }
    .turn-obj {
      position: relative;
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
      transform-style: preserve-3d;
    }
    .turn-obj .f {
      position: absolute;
      inset: 0;
      margin: auto;
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      /* 뒷면은 감춘다 — 돌아서 등을 보이면 사라지고 반대쪽이 나타난다 */
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      will-change: transform;
      transform: rotateY(0deg);
    }
    .turn-obj .b { transform: rotateY(180deg); }

    /* 읽는 자리 — 장면이 바뀌면 글도 바뀐다 */
    .turn-copy {
      position: relative;
      flex: 0 0 25vh;
      width: 100%;
      max-width: 460px;
    }
    .turn-copy .cp {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      font-family: 'Noto Serif KR', Georgia, serif;
      will-change: opacity, transform;
      pointer-events: none;
    }
    .turn-copy .cp b {
      display: block;
      font-size: 17px;
      font-weight: 700;
      color: #2f2109;
      letter-spacing: -.01em;
    }
    .turn-copy .cp b::after {
      content: '';
      display: block;
      width: 26px;
      height: 1px;
      margin: 11px auto;
      background: rgba(156,116,32,.55);
    }
    .turn-copy .cp p {
      margin: 0;
      font-size: 13px;
      line-height: 2;
      color: #6b5a3c;
      white-space: pre-line;
      text-wrap: balance;
    }

    /* 더 내려가라는 얇은 표시 */
    .turn-hint {
      position: absolute;
      bottom: 3vh;
      left: 50%;
      width: 1px;
      height: 28px;
      transform: translateX(-50%);
      background: linear-gradient(#c9ab6b, transparent);
      will-change: opacity;
    }

    @media (max-width: 640px) {
      .turn-copy { flex-basis: 27vh; }
      .turn-copy .cp b { font-size: 15.5px; }
      .turn-copy .cp p { font-size: 12px; line-height: 1.95; }
    }

    /* 움직임을 원치 않는 사람에겐 장면과 글을 그냥 위아래로 */
    @media (prefers-reduced-motion: reduce) {
      .turn { height: auto; }
      .turn-stage { position: static; height: auto; display: block; perspective: none; }
      .turn-obj { height: auto; }
      .turn-obj .f {
        position: static;
        display: block;
        margin: 0 auto;
        max-height: 62vh;
        transform: none !important;
        backface-visibility: visible;
      }
      .turn-obj .b { margin-top: 40px; }
      .turn-copy { position: static; height: auto; margin: 22px auto 0; max-width: 460px; }
      .turn-copy .cp {
        position: static;
        opacity: 1 !important;
        transform: none !important;
        margin-bottom: 26px;
      }
      .turn-hint { display: none; }
    }
  </style>

  <script is:inline>
    (function () {
      var sec = document.getElementById('turn');
      if (!sec) return;
      var a = sec.querySelector('.f.a');
      var b = sec.querySelector('.f.b');
      var hint = sec.querySelector('.turn-hint');
      var caps = [].map.call(sec.querySelectorAll('.cp'), function (el) {
        return {el: el, w: (el.getAttribute('data-win') || '').split(',').map(Number)};
      });

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // 창(win) 안에서의 밝기 — 떠오르고, 머물고, 사라진다
      function fade(p, w) {
        if (p <= w[0]) return 0;
        if (p < w[1]) return (p - w[0]) / (w[1] - w[0]);
        if (p <= w[2]) return 1;
        if (p < w[3]) return 1 - (p - w[2]) / (w[3] - w[2]);
        return 0;
      }

      var ticking = false;

      function paint() {
        ticking = false;
        var rect = sec.getBoundingClientRect();
        // 이 구간을 얼마나 지나왔나 — 0(막 닿음) ~ 1(다 지남)
        var span = rect.height - window.innerHeight;
        var p = span > 0 ? -rect.top / span : 0;
        p = p < 0 ? 0 : p > 1 ? 1 : p;

        // 스크롤 = 회전각. 양 끝은 천천히(읽는 동안 가만히), 가운데서 빨리 돈다.
        // 옆면(90°)은 납작해서 아무것도 안 보이는 순간이라 거기를 서둘러 지난다.
        var u = 2 * p - 1;
        var deg = 90 + 90 * (u < 0 ? -1 : 1) * Math.pow(Math.abs(u), 0.4);
        var r = deg * Math.PI / 180;
        var s = Math.sin(r);
        var z = -170 * s;                       // 돌면서 한 번 물러났다 돌아온다
        var tilt = -7 * s;                      // 옆을 보일 때 살짝 기운다
        var base = 'translateZ(' + z.toFixed(1) + 'px) rotateX(' + tilt.toFixed(2) + 'deg) rotateY(';

        a.style.transform = base + (-deg).toFixed(2) + 'deg)';
        // 뒷장은 사람이 함께 있어 책이 작게 잡힌다 — 책 크기를 맞춰 준다
        b.style.transform = base + (180 - deg).toFixed(2) + 'deg) scale(1.08)';

        for (var i = 0; i < caps.length; i++) {
          var o = fade(p, caps[i].w);
          caps[i].el.style.opacity = o.toFixed(3);
          // 덜 보일수록 조금 아래에 — 떠오르듯 들어오고 가라앉듯 나간다
          caps[i].el.style.transform = 'translateY(' + ((1 - o) * 12).toFixed(1) + 'px)';
        }

        hint.style.opacity = Math.max(0, 1 - p * 5).toFixed(3);
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(paint);
      }

      addEventListener('scroll', onScroll, {passive: true});
      addEventListener('resize', onScroll);
      paint();
    })();
  </script>
</Base>
